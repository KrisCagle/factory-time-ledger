#!/usr/bin/env ruby
# Installs gems, starts the app's Postgres (Docker), and prepares the database.
#
#   bin/setup          Safe to re-run. Creates and migrates the database, and
#                      loads demo data only when the database is brand new.
#                      Never deletes existing data.
#   bin/setup --reset  Deletes everything and reloads demo data. Don't use this
#                      once you're logging real time.
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
RESET = ARGV.include?("--reset")

def system!(*args)
  system(*args, exception: true)
end

def env_value(key)
  line = File.readlines(".env").map(&:strip).find { |l| l.start_with?("#{key}=") }
  line&.split("=", 2)&.last&.delete('"')
end

FileUtils.chdir APP_ROOT do
  puts "== Installing gems =="
  system("bundle check") || system!("bundle install")

  unless File.exist?(".env")
    puts "\n== Creating .env from .env.example =="
    FileUtils.cp ".env.example", ".env"
  end

  if env_value("USE_DOCKER_DB") == "false"
    puts "\n== Using your own Postgres (USE_DOCKER_DB=false) =="
  else
    unless system("docker info > /dev/null 2>&1")
      abort <<~MSG

        Docker isn't running, and this app's database runs in Docker by default.
        Either start Docker Desktop and re-run bin/setup, or point .env at your own
        Postgres (DB_USER, DB_PASSWORD, DB_PORT) and set USE_DOCKER_DB=false.
      MSG
    end
    puts "\n== Starting Postgres in Docker (port 5434) =="
    system! "docker compose up -d --wait db"
  end

  if RESET
    puts "\n== Resetting the database and loading demo data (--reset) =="
    system! "bin/rails db:drop db:create db:migrate db:seed"
  else
    # db:prepare creates + migrates + seeds a new database, and only migrates
    # an existing one, so real data is never touched.
    puts "\n== Preparing database =="
    system! "bin/rails db:prepare"
  end

  puts "\n== Done. Start the app with: bin/dev =="
  puts "   Then open http://localhost:3001"
end
