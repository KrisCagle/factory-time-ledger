# Database. Defaults assume a local Postgres on localhost:5432 using your OS user.
# If you use the bundled docker-compose.yml, uncomment these two lines:
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5434

# Time zone used to decide which day time belongs to.
LEDGER_TIME_ZONE="Central Time (US & Canada)"

# Token factories send in the X-Ledger-Token header when posting events.
# Leave blank in development to accept unauthenticated local requests.
LEDGER_API_TOKEN=

# Harvest. Leave blank to stay in dry-run mode (nothing is sent to Harvest).
# Create a personal access token at https://id.getharvest.com/developers
HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=
