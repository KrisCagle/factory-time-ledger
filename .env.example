# Database. These match the bundled docker-compose.yml, which bin/setup starts.
# To use your own Postgres instead, change these and set USE_DOCKER_DB=false.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
USE_DOCKER_DB=true

# Time zone used to decide which day time belongs to.
LEDGER_TIME_ZONE="Central Time (US & Canada)"

# Token factories send in the X-Ledger-Token header when posting events.
# Leave blank in development to accept unauthenticated local requests.
LEDGER_API_TOKEN=

# Harvest. Leave blank to stay in dry-run mode (nothing is sent to Harvest).
# Create a personal access token at https://id.getharvest.com/developers
HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=

# Scarif (read-only). A personal API token from Scarif → Settings → API tokens,
# with just the work_item:read scope. Leave blank to skip the Scarif sync.
SCARIF_API_TOKEN=
# SCARIF_URL=https://scarif.twinsun.dev
# SCARIF_SYNC_MINUTES=5
# SCARIF_POLL=false   # turn off background sync (use Settings → Sync now)
