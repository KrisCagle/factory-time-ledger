<% content_for :title, @batch.display_name %>
<div class="page-head">
  <div>
    <p class="crumb"><%= link_to "Batches", batches_path %> /</p>
    <h1><%= @batch.display_name %></h1>
    <p class="muted">Started <%= @batch.started_at.strftime("%b %-d at %-l:%M %p") %><%= " by #{@batch.started_by.name}" if @batch.started_by %> · <%= @batch.source %></p>
  </div>
</div>

<div class="stats">
  <div class="stat"><span class="stat-label">Tickets</span><span class="stat-value"><%= @items.size %></span></div>
  <div class="stat"><span class="stat-label">Batch overhead</span><span class="stat-value"><%= duration(@overhead_spans.sum(&:seconds)) %></span></div>
  <div class="stat"><span class="stat-label">Agent time</span><span class="stat-value"><%= duration(@items.sum(&:agent_seconds)) %></span></div>
  <div class="stat"><span class="stat-label">Agent cost</span><span class="stat-value"><%= money(@items.sum(&:agent_cost_usd)) %></span></div>
</div>

<section class="card">
  <h2>How overhead splits across tickets</h2>
  <% if @split&.rule_used %>
    <p class="hint">
      Split rule: <strong><%= rule_label(@split.rule_used) %></strong>
      <% if @split.rule_used.to_s != @setting.split_rule %>
        (set to <%= rule_label(@setting.split_rule) %>, but fell back because not every ticket has a value)
      <% end %>
      · <%= link_to "Change rule", settings_path %>
    </p>
  <% end %>
  <table class="table">
    <thead><tr><th>Ticket</th><th>Status</th><th class="num">Agent points</th><th class="num">Agent time</th><th class="num">Share</th><th class="num">Overhead drafted</th></tr></thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= link_to item.jira_key, work_item_path(item), class: "key" %> <span class="muted"><%= item.summary.to_s.truncate(44) %></span></td>
          <td><%= status_pill(item.status) %></td>
          <td class="num"><%= item.agent_points || "—" %></td>
          <td class="num"><%= duration(item.agent_seconds) %></td>
          <td class="num">
            <% share = @split&.shares&.dig(item.id) %>
            <% if share %>
              <div class="share"><span class="share-bar" style="width: <%= (share * 100).round(1) %>%"></span><span><%= (share * 100).round(1) %>%</span></div>
            <% else %>—<% end %>
          </td>
          <td class="num"><%= duration(item.time_drafts.sum(&:overhead_seconds)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>Overhead time</h2>
  <% if @overhead_spans.empty? %>
    <p class="empty">No batch-level time recorded.</p>
  <% else %>
    <table class="table">
      <thead><tr><th>Who</th><th>Activity</th><th>When</th><th class="num">Time</th></tr></thead>
      <tbody>
        <% @overhead_spans.each do |span| %>
          <tr>
            <td><%= span.person.name %></td>
            <td><%= activity_label(span.activity) %></td>
            <td><%= span.started_at.strftime("%b %-d, %-l:%M") %>–<%= span.last_seen_at.strftime("%-l:%M %p") %></td>
            <td class="num"><%= duration(span.seconds) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
