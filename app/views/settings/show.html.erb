<% content_for :title, "Settings" %>
<div class="page-head"><div><h1>Settings</h1></div></div>

<section class="card">
  <h2>Attribution rules</h2>
  <%= form_with model: @setting, url: settings_path, method: :patch, class: "form-row" do |f| %>
    <label>Split batch overhead by
      <%= f.select :split_rule, [["Agent points (falls back to agent time, then even)", "agent_points"], ["Agent time (falls back to even)", "agent_time"], ["Even split", "even"]], {}, class: "input" %>
    </label>
    <label>Idle after (minutes)
      <%= f.number_field :idle_gap_minutes, min: 1, max: 60, class: "input input-small" %>
    </label>
    <label>Round entries to (minutes)
      <%= f.number_field :rounding_minutes, min: 0, max: 60, class: "input input-small" %>
    </label>
    <%= f.submit "Save", class: "btn btn-primary" %>
  <% end %>
  <p class="hint">Rounding of 6 matches Harvest's 0.1-hour increments. 0 or 1 keeps minute precision.</p>
</section>

<section class="card" id="harvest">
  <div class="card-head">
    <h2>Harvest connection</h2>
    <% if @checklist.complete? %>
      <%= status_pill("live") %>
    <% elsif @harvest_configured && @setting.harvest_checked? && !@setting.harvest_timestamp_mode %>
      <%= status_pill("connected") %>
    <% elsif @harvest_configured %>
      <%= status_pill("needs check") %>
    <% else %>
      <%= status_pill("dry run") %>
    <% end %>
  </div>

  <div class="checklist">
    <p class="checklist-head"><strong>Going live</strong> <span class="muted"><%= @checklist.done_count %> of <%= @checklist.steps.size %> done</span></p>
    <ol>
      <% @checklist.steps.each do |step| %>
        <li class="<%= step.done ? 'done' : 'todo' %>">
          <span class="check"><%= step.done ? "✓" : "" %></span>
          <span><strong><%= step.title %></strong> <span class="muted small">— <%= step.detail %></span></span>
        </li>
      <% end %>
    </ol>
    <% unless @harvest_configured %>
      <p class="hint">Create a Personal Access Token at <a href="https://id.getharvest.com/developers" target="_blank" rel="noopener">id.getharvest.com/developers</a>. The same page shows your account ID.</p>
    <% end %>
  </div>

  <% if @harvest_configured %>
    <dl class="facts">
      <dt>Account</dt><dd><%= @setting.harvest_account_name || "—" %></dd>
      <dt>Signed in as</dt><dd><%= @setting.harvest_user_name.presence || "—" %><%= " (#{@setting.harvest_user_email})" if @setting.harvest_user_email.present? %></dd>
      <dt>Time tracking</dt>
      <dd>
        <% if @setting.harvest_timestamp_mode.nil? %>—
        <% elsif @setting.harvest_timestamp_mode %><span class="warn">Start and end times. This app can only send durations, so sending is blocked. A Harvest admin can switch the account to durations.</span>
        <% else %>Durations ✓<% end %>
      </dd>
      <dt>Last checked</dt><dd><%= @setting.harvest_checked_at ? time_ago_in_words(@setting.harvest_checked_at) + " ago" : "never" %></dd>
      <dt>Projects</dt>
      <dd><%= @setting.harvest_projects_loaded? ? "#{@harvest_projects.size} loaded #{time_ago_in_words(@setting.harvest_projects_synced_at)} ago" : "not loaded yet" %></dd>
    </dl>
    <% if @setting.harvest_check_error.present? %><p class="small warn"><%= @setting.harvest_check_error %></p><% end %>
  <% end %>

  <div class="actions">
    <%= button_to "Test connection", check_harvest_connection_path, class: "btn", disabled: !@harvest_configured %>
    <%= button_to "Load projects from Harvest", load_projects_harvest_connection_path, class: "btn", disabled: !@harvest_configured %>
  </div>

  <% if @harvest_configured %>
    <div class="test-entry">
      <h3>Test entry</h3>
      <% if @testable_projects.any? %>
        <%= form_with url: test_entry_harvest_connection_path, method: :post, class: "form-row" do %>
          <label>Project
            <%= select_tag :project_id, options_from_collection_for_select(@testable_projects, :id, :name), class: "input" %>
          </label>
          <button type="submit" class="btn btn-primary">Run test entry</button>
        <% end %>
        <p class="hint">Creates a 0.01-hour entry on the project's Development task, reads it back, then deletes it. Nothing is left in your timesheet.</p>
      <% else %>
        <p class="hint">Map a repo to one of your Harvest projects below to run a test entry.</p>
      <% end %>
      <% if @setting.harvest_test_log.present? %>
        <ul class="test-log">
          <% @setting.harvest_test_log.each do |step| %>
            <li class="<%= step["ok"] ? "ok" : "bad" %>"><span class="check"><%= step["ok"] ? "✓" : "✗" %></span> <%= step["name"] %> <span class="muted small">— <%= step["detail"] %></span></li>
          <% end %>
        </ul>
        <% if @setting.harvest_test_passed_at %><p class="hint">Last passed <%= time_ago_in_words(@setting.harvest_test_passed_at) %> ago.</p><% end %>
      <% end %>
    </div>
  <% end %>

  <p class="hint">Sending to Harvest stays blocked until the connection is checked, the account tracks durations, and each project is one you've loaded from Harvest. That way demo data or a mistyped ID can't land on the wrong project.</p>
</section>

<section class="card" id="scarif">
  <div class="card-head">
    <h2>Scarif connection</h2>
    <% if @scarif_configured && @setting.scarif_checked? %>
      <%= status_pill("connected") %>
    <% elsif @scarif_configured %>
      <%= status_pill("needs check") %>
    <% else %>
      <%= status_pill("not connected") %>
    <% end %>
  </div>
  <p class="hint">Reads your Scarif work items (read-only) so their agent time, agent cost, asks, and batches show up here next to everything else. Needs a Scarif personal API token with just the <code>work_item:read</code> scope.</p>

  <% if !@scarif_configured %>
    <ol class="steps">
      <li>In Scarif, open <strong>Settings → API tokens</strong> and create a token with only <code>work_item:read</code>.</li>
      <li>Add it to <code>.env</code> as <code>SCARIF_API_TOKEN=...</code>, then restart <code>bin/dev</code>.</li>
      <li>Come back here and click <strong>Test connection</strong>.</li>
    </ol>
  <% else %>
    <dl class="facts">
      <dt>Scarif</dt><dd><%= Scarif::Client.base_url %></dd>
      <dt>Signed in as</dt><dd><%= @setting.scarif_user_name.presence || "—" %><%= " (#{@setting.scarif_user_email})" if @setting.scarif_user_email.present? %></dd>
      <dt>Token scopes</dt>
      <dd>
        <%= @setting.scarif_token_scopes.presence&.join(", ") || "—" %>
        <% extra = @setting.scarif_token_scopes & Scarif::CheckConnection::WRITE_SCOPES %>
        <% if extra.any? %><div class="small warn">This token can also change things in Scarif. The ledger only reads, but a token with just work_item:read is safer.</div><% end %>
      </dd>
      <dt>Last sync</dt>
      <dd>
        <% if @setting.scarif_last_synced_at %><%= time_ago_in_words(@setting.scarif_last_synced_at) %> ago<% else %>never<% end %>
        <% if @setting.scarif_last_sync_summary.present? %><div class="muted small"><%= @setting.scarif_last_sync_summary %></div><% end %>
      </dd>
      <dt>Tickets from Scarif</dt><dd><%= @scarif_ticket_count %></dd>
      <dt>Background sync</dt>
      <dd><%= Scarif::Poller.running? ? "every #{(Scarif::Poller.interval / 60).round} minutes while the app runs" : "off (use Sync now)" %></dd>
    </dl>
    <% if @setting.scarif_check_error.present? %><p class="small warn"><%= @setting.scarif_check_error %></p><% end %>
    <% if @setting.scarif_sync_error.present? %><p class="small warn">Last sync failed: <%= @setting.scarif_sync_error %></p><% end %>

    <%= form_with model: @setting, url: scarif_connection_path, method: :patch, class: "form-row" do |f| %>
      <label class="inline-check"><%= f.check_box :scarif_only_mine %> Only work items I enqueued</label>
      <label>Look back (days) <%= f.number_field :scarif_lookback_days, min: 1, max: 90, class: "input input-small" %></label>
      <%= f.submit "Save", class: "btn btn-small" %>
    <% end %>
  <% end %>

  <div class="actions">
    <%= button_to "Test connection", check_scarif_connection_path, class: "btn", disabled: !@scarif_configured %>
    <%= button_to "Sync now", sync_scarif_connection_path, class: "btn btn-primary", disabled: !@scarif_configured %>
  </div>
</section>

<section class="card">
  <h2>Projects → Harvest</h2>
  <% pickers = @harvest_projects.any? %>
  <p class="hint">
    Each repo's time goes to one Harvest project. Review and QA share the QA task.
    <%= pickers ? "Picking a project fills in tasks whose names match; check them before saving." : "Load projects from Harvest above to pick from lists instead of typing IDs." %>
  </p>
  <table class="table" data-harvest-mapping data-harvest-tasks="<%= @harvest_projects.to_h { |hp| [hp.harvest_id, hp.tasks.map { |t| { id: t["id"], name: t["name"] } }] }.to_json %>">
    <thead><tr><th>Repo</th><th>Name</th><th>Harvest project</th><th>Development task</th><th>QA task</th><th>Supervision task</th><th></th></tr></thead>
    <tbody>
      <% rows = @projects.map { |p| [p, "project_form_#{p.id}"] } + [[@new_project, "project_form_new"]] %>
      <% rows.each do |project, fid| %>
        <% hp = project.persisted? ? project.harvest_project : nil %>
        <tr data-mapping-row>
          <td class="small">
            <% if project.persisted? %><%= project.repo %><% else %><%= text_field_tag "project[repo]", nil, placeholder: "owner/repo", class: "input", form: fid %><% end %>
          </td>
          <td><%= text_field_tag "project[name]", project.name, placeholder: "Display name", class: "input", form: fid %></td>
          <% if pickers %>
            <td><%= select_tag "project[harvest_project_id]", harvest_project_options(@harvest_projects, project.harvest_project_id), class: "input", form: fid, data: { role: "project" } %></td>
            <% { harvest_dev_task_id: "dev", harvest_qa_task_id: "qa", harvest_supervision_task_id: "supervision" }.each do |field, role| %>
              <td><%= select_tag "project[#{field}]", harvest_task_options(hp, project.public_send(field)), class: "input", form: fid, data: { role: } %></td>
            <% end %>
          <% else %>
            <% %i[harvest_project_id harvest_dev_task_id harvest_qa_task_id harvest_supervision_task_id].each do |field| %>
              <td><%= number_field_tag "project[#{field}]", project.public_send(field), placeholder: "ID", class: "input", form: fid %></td>
            <% end %>
          <% end %>
          <td>
            <%= form_with url: project.persisted? ? project_path(project) : projects_path, method: project.persisted? ? :patch : :post, id: fid do %>
              <button type="submit" class="btn btn-small"><%= project.persisted? ? "Save" : "Add" %></button>
            <% end %>
            <% if project.persisted? %>
              <% problem = Activity::ALL.filter_map { |a| harvest_mapping_problem(project, a) }.first %>
              <% if problem %><div class="small warn"><%= problem %></div><% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<script>
(() => {
  const table = document.querySelector("[data-harvest-mapping]");
  if (!table || table.dataset.wired) return;
  table.dataset.wired = "1";
  const tasksByProject = JSON.parse(table.dataset.harvestTasks || "{}");
  // Best-guess task for each slot, by name. Always shown for review before saving.
  const patterns = {
    dev: /develop|engineer|program|build|coding|implement/i,
    qa: /\bqa\b|quality|test|review/i,
    supervision: /supervis|project manag|management|\bpm\b|factory|planning|coordinat/i
  };

  table.querySelectorAll('[data-role="project"]').forEach(projectSelect => {
    projectSelect.addEventListener("change", () => {
      const row = projectSelect.closest("[data-mapping-row]");
      const tasks = tasksByProject[projectSelect.value] || [];
      Object.keys(patterns).forEach(role => {
        const select = row.querySelector(`[data-role="${role}"]`);
        if (!select) return;
        select.innerHTML = "";
        select.add(new Option("— pick a task —", ""));
        tasks.forEach(t => select.add(new Option(t.name, t.id)));
        const match = tasks.find(t => patterns[role].test(t.name));
        if (match) select.value = String(match.id);
      });
    });
  });
})();
</script>

<section class="card">
  <h2>People</h2>
  <ul class="plain">
    <% people.each do |person| %>
      <li><strong><%= person.name %></strong> <span class="muted"><%= person.email %></span><%= " · Harvest user ##{person.harvest_user_id}" if person.harvest_user_id %></li>
    <% end %>
  </ul>
  <%= form_with model: @new_person, class: "form-row" do |f| %>
    <%= f.text_field :name, placeholder: "Name", class: "input" %>
    <%= f.email_field :email, placeholder: "Email (matches what factories send)", class: "input" %>
    <%= f.number_field :harvest_user_id, placeholder: "Harvest user ID (optional)", class: "input" %>
    <%= f.submit "Add person", class: "btn" %>
  <% end %>
</section>

<section class="card">
  <h2>Connecting factories</h2>
  <p>Factories post events to <code>POST <%= request.base_url %>/api/v1/events</code> and attention heartbeats to <code>POST <%= request.base_url %>/api/v1/attention</code>. See the README for the payload format.</p>
  <p class="hint">API token: <%= ENV["LEDGER_API_TOKEN"].present? ? "set (send it as X-Ledger-Token)" : "not set, so local requests are accepted without one" %>. Harvest: <%= Harvest::Client.configured? ? "token set" : "not connected (dry run)" %>. Scarif: <%= Scarif::Client.configured? ? "token set" : "not connected" %>.</p>
</section>

<% if @demo_present %>
  <section class="card">
    <h2>Demo data</h2>
    <p>The demo tickets, batches, and people are still here. Remove them before logging real time, so your Today page and drafts only show real work. Real tickets, projects, and Harvest settings are kept.</p>
    <%= button_to "Remove demo data", demo_data_path, method: :delete, class: "btn btn-danger", form: { onsubmit: "return confirm('Remove all demo tickets, batches, people, and drafts? Real data is kept.')" } %>
  </section>
<% end %>
