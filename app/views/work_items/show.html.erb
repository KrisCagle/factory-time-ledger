<% content_for :title, @work_item.jira_key %>
<% direct = @work_item.direct_seconds_by_activity %>
<% drafted = @work_item.drafted_seconds_by_activity %>
<div class="page-head">
  <div>
    <p class="crumb"><%= link_to "Tickets", work_items_path %> /</p>
    <h1><%= @work_item.jira_key %> <%= status_pill(@work_item.status) %></h1>
    <p class="muted"><%= @work_item.summary %></p>
    <p class="muted small">
      <%= @work_item.project&.repo || "No project" %>
      <% if @work_item.batch %> · <%= link_to @work_item.batch.display_name, batch_path(@work_item.batch) %><% end %>
      · <%= @work_item.agent_points ? "#{@work_item.agent_points} agent points" : "unsized" %>
      · via <%= @work_item.source %>
    </p>
  </div>
</div>

<div class="stats">
  <div class="stat"><span class="stat-label">Human (direct)</span><span class="stat-value"><%= duration(direct.values.sum) %></span></div>
  <div class="stat"><span class="stat-label">Drafted to Harvest</span><span class="stat-value"><%= duration(drafted.values.sum) %></span></div>
  <div class="stat"><span class="stat-label">Agent time</span><span class="stat-value"><%= duration(@work_item.agent_seconds) %></span></div>
  <div class="stat"><span class="stat-label">Agent cost</span><span class="stat-value"><%= money(@work_item.agent_cost_usd) %></span></div>
  <div class="stat"><span class="stat-label">Rework loops</span><span class="stat-value <%= 'warn' if @work_item.rework_count.positive? %>"><%= @work_item.rework_count %></span></div>
</div>

<div class="grid-2">
  <section class="card">
    <h2>Human time by activity</h2>
    <table class="table">
      <thead><tr><th>Activity</th><th class="num">Direct</th><th class="num">Drafted (incl. overhead)</th></tr></thead>
      <tbody>
        <% Activity::ALL.each do |activity| %>
          <% next if direct[activity].to_i.zero? && drafted[activity].to_i.zero? %>
          <tr><td><%= activity_label(activity) %></td><td class="num"><%= duration(direct[activity]) %></td><td class="num"><%= duration(drafted[activity]) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2>Agent runs</h2>
    <% if @work_item.agent_runs.empty? %>
      <p class="empty">No agent runs recorded.</p>
    <% else %>
      <table class="table">
        <thead><tr><th>Stage</th><th>Started</th><th class="num">Time</th><th class="num">Cost</th></tr></thead>
        <tbody>
          <% @work_item.agent_runs.sort_by { |r| r.started_at || Time.current }.each do |run| %>
            <tr>
              <td><%= run.stage_type&.humanize || run.external_id %></td>
              <td><%= run.started_at&.strftime("%b %-d, %-l:%M %p") || "—" %></td>
              <td class="num"><%= run.completed_at ? duration(run.seconds) : "running" %></td>
              <td class="num"><%= run.cost_usd ? money(run.cost_usd) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
</div>

<% run = @work_item.foreman_run %>
<% if run %>
  <section class="card" id="foreman-process">
    <div class="card-head">
      <h2>Process in Foreman</h2>
      <span class="muted small">checked <%= time_ago_in_words(run.fetched_at) %> ago</span>
    </div>
    <% if !run.followed %>
      <p class="empty">Foreman doesn't follow <%= @work_item.jira_key %> (no inferred run for it).</p>
    <% else %>
      <p class="muted small">
        <%= run.workflow %><%= "@#{run.workflow_version}" if run.workflow_version.present? %>
        <% if run.client.present? %> · client <%= run.client %><% end %>
        · <% if run.status == "completed" %>completed<% else %>at <strong><%= run.position.to_s.humanize %></strong>, <%= run.state_label %><% end %>
        <%= " · dormant" if run.dormant %>
      </p>
      <div class="stats">
        <div class="stat"><span class="stat-label">Waiting for someone</span><span class="stat-value"><%= duration(run.total_wait_seconds) %></span></div>
        <div class="stat"><span class="stat-label">Being worked on</span><span class="stat-value"><%= duration(run.total_work_seconds) %></span></div>
        <div class="stat"><span class="stat-label">Steps visited</span><span class="stat-value"><%= run.steps.size %></span></div>
      </div>
      <% harvest_id = LedgerSetting.current.harvest_user_id %>
      <table class="table">
        <thead><tr><th>Step</th><th>Entered</th><th class="num">Waited</th><th class="num">Worked</th><th>Picked up by</th><th>Outcome</th></tr></thead>
        <tbody>
          <% run.steps.each do |step| %>
            <tr>
              <td><%= step.node.to_s.humanize %></td>
              <td class="small"><%= step.entered_at&.strftime("%b %-d, %-l:%M %p") || "—" %></td>
              <td class="num"><%= duration(step.wait_seconds) %></td>
              <td class="num"><%= step.claimed_at ? duration(step.work_seconds) : "—" %></td>
              <td class="small">
                <% if step.mine?(harvest_id) %><strong>You</strong><% elsif step.implementor_type.present? %><%= step.implementor_type.humanize %><% else %>—<% end %>
                <% if step.claim_source.present? && step.claim_source != "none" %><span class="muted">(seen in <%= step.claim_source %>)</span><% end %>
              </td>
              <td class="small"><%= step.open? ? "in progress" : step.outcome.to_s.humanize %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if run.timeline.present? %>
        <h3>Foreman timeline</h3>
        <ol class="events">
          <% run.timeline.each do |entry| %>
            <li class="event">
              <span class="event-time"><%= Time.zone.parse(entry["at"].to_s)&.strftime("%b %-d, %-l:%M %p") %></span>
              <span class="event-label"><%= entry["summary"].presence || entry["kind"] %></span>
              <% actor = entry["actor"].is_a?(Hash) ? (entry["actor"]["name"] || entry["actor"]["email"] || entry["actor"]["id"]) : entry["actor"] %>
              <% if actor.present? %><span class="muted small">— <%= actor %></span><% end %>
            </li>
          <% end %>
        </ol>
      <% end %>
    <% end %>
  </section>
<% end %>

<section class="card">
  <h2>Pipeline timeline</h2>
  <ol class="events">
    <% @work_item.pipeline_events.each do |event| %>
      <li class="event event-<%= event.event_type.dasherize %>">
        <span class="event-time"><%= event.occurred_at.strftime("%b %-d, %-l:%M %p") %></span>
        <span class="event-label"><%= event.label %></span>
        <% details = event.data.slice("stage_type", "cost_usd", "pr_number", "conclusion", "reason") %>
        <% if details.any? %><span class="muted small"><%= details.map { |k, v| "#{k.humanize.downcase}: #{v}" }.join(" · ") %></span><% end %>
        <% if event.person %><span class="muted small">— <%= event.person.name %></span><% end %>
      </li>
    <% end %>
  </ol>
</section>

<%= render "shared/work_timer", work_item: @work_item %>
